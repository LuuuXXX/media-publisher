{
  "appId": "com.mediapublisher.app",
  "productName": "Media Publisher",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "public/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity"
  },
  "win": {
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
