LICENSE_SERVER=https://your-domain.com/api
# 生产环境必填：用于许可证 HMAC 签名，请使用强随机字符串
LICENSE_HMAC_SECRET=replace-with-strong-random-secret
# 可选：开发模式下 Vite dev server 地址（主进程通过 VITE_DEV_SERVER_URL 判断是否加载 dev server）
# 注意：主进程不读取 .env，此变量须在启动命令中显式注入，例如：
#   VITE_DEV_SERVER_URL=http://localhost:5173 npm run dev
# VITE_DEV_SERVER_URL=http://localhost:5173
